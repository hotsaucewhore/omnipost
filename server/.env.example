# OmniPost Upload Relay, Auth & Billing Server Configuration
PORT=4000
PUBLIC_SERVER_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:8081
ADMIN_EMAIL=founder@omnipost.app

# --- Transactional Emails (Resend HTTP API — optional, falls back to local outbox in /admin) ---
RESEND_API_KEY=
EMAIL_FROM="OmniPost Studio <notifications@yourdomain.com>"

# --- SaaS Billing (Stripe Checkout) ---
# Add STRIPE_SECRET_KEY (e.g. sk_test_... or sk_live_...) to switch from local sandbox billing to real Stripe Checkout.
# Price IDs are optional: if omitted, OmniPost automatically generates inline $12/$10 Creator & $29/$24 Studio Stripe subscriptions!
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_MONTHLY_PRICE_ID=
STRIPE_CREATOR_ANNUAL_PRICE_ID=
STRIPE_STUDIO_MONTHLY_PRICE_ID=
STRIPE_STUDIO_ANNUAL_PRICE_ID=

# --- Platform OAuth & Direct Publishing Keys ---
# 1. TikTok Direct Post API (https://developers.tiktok.com/)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# 2. Meta App for Instagram & Facebook (https://developers.facebook.com/)
META_APP_ID=
META_APP_SECRET=

# 3. Google Cloud OAuth for YouTube Shorts & Long-Form (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 4. X / Twitter OAuth 2.0 (https://developer.x.com/)
X_CLIENT_ID=
X_CLIENT_SECRET=

# 5. Meta Threads API (https://developers.facebook.com/)
THREADS_APP_ID=
THREADS_APP_SECRET=

# 6. Bluesky AT Protocol App Password (optional — users can also connect directly in the Accounts UI!)
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# 7. LinkedIn Posts API (https://www.linkedin.com/developers/)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
