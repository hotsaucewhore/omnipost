{
  "expo": {
    "name": "OmniPost Studio",
    "slug": "omnipost-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "omnipost",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.omnipoststudio.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "OmniPost Studio needs photo library access so you can select videos, carousel photos, and custom thumbnails to publish across your connected social accounts."
      }
    },
    "android": {
      "package": "com.omnipoststudio.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F4F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OmniPost Studio to access your videos and photos for cross-platform publishing."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F4F0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
